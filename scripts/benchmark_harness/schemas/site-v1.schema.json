{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvidia.github.io/daqiri/schemas/benchmark-site-v1.json",
  "title": "DAQIRI benchmark site profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "topology_ownership", "hosts", "links", "pairs", "contamination_checks"],
  "properties": {
    "schema_version": {"const": "daqiri.benchmark-site/v1"},
    "name": {"$ref": "#/$defs/id"},
    "topology_ownership": {"const": "external"},
    "hosts": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {"$ref": "#/$defs/host"}
    },
    "links": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tx", "rx"],
        "properties": {
          "tx": {"$ref": "#/$defs/linkEndpoint"},
          "rx": {"$ref": "#/$defs/linkEndpoint"}
        }
      }
    },
    "pairs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "link", "tx", "rx"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "link": {"$ref": "#/$defs/id"},
          "tx": {"$ref": "#/$defs/placement"},
          "rx": {"$ref": "#/$defs/placement"}
        }
      }
    },
    "contamination_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "host", "argv", "expect_stdout_empty"],
        "properties": {
          "name": {"$ref": "#/$defs/id"},
          "host": {"$ref": "#/$defs/id"},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "expect_stdout_empty": {"type": "boolean"}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transport", "worktree", "runtime_root", "python", "worker_prefix",
        "benchmark_binary", "expected_binary_sha256", "expected_commit", "require_clean", "container"
      ],
      "properties": {
        "transport": {"enum": ["local", "ssh"]},
        "destination": {"type": "string", "minLength": 1},
        "worktree": {"type": "string", "minLength": 1},
        "runtime_root": {"type": "string", "minLength": 1},
        "python": {"type": "string", "minLength": 1},
        "worker_prefix": {
          "oneOf": [
            {"type": "array", "maxItems": 0},
            {"const": ["sudo", "-n"]}
          ]
        },
        "benchmark_binary": {"type": "string", "minLength": 1},
        "expected_binary_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "expected_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "require_clean": {"type": "boolean"},
        "container": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runtime", "image", "digest", "workdir", "gpus"],
          "properties": {
            "runtime": {"enum": ["none", "docker"]},
            "image": {"type": "string"},
            "digest": {"type": "string"},
            "workdir": {"type": "string"},
            "gpus": {"type": "boolean"}
          },
          "oneOf": [
            {
              "properties": {
                "runtime": {"const": "none"},
                "image": {"const": ""},
                "digest": {"const": ""},
                "workdir": {"const": ""},
                "gpus": {"const": false}
              }
            },
            {
              "properties": {
                "runtime": {"const": "docker"},
                "image": {"type": "string", "minLength": 1},
                "digest": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"},
                "workdir": {"type": "string", "pattern": "^/"}
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"transport": {"const": "ssh"}}},
          "then": {"required": ["destination"]},
          "else": {"not": {"required": ["destination"]}}
        },
        {
          "if": {
            "properties": {
              "container": {
                "properties": {"runtime": {"const": "docker"}}
              }
            }
          },
          "then": {
            "properties": {
              "benchmark_binary": {"type": "string", "pattern": "^/"}
            }
          }
        }
      ]
    },
    "linkEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host", "netdev", "pci", "ip", "mac", "mtu", "speed_mbps",
        "irq_cpus", "napi_cpus", "queue_capacity"
      ],
      "properties": {
        "host": {"$ref": "#/$defs/id"},
        "netdev": {"type": "string", "minLength": 1},
        "pci": {"type": "string", "minLength": 1},
        "ip": {"type": "string", "minLength": 1},
        "mac": {"type": "string", "minLength": 1},
        "mtu": {"type": "integer", "minimum": 1},
        "speed_mbps": {"type": "integer", "minimum": 1},
        "irq_cpus": {"$ref": "#/$defs/cpus"},
        "napi_cpus": {"$ref": "#/$defs/cpus"},
        "queue_capacity": {"type": "integer", "minimum": 1}
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_port", "remote_port", "queue_id", "io_cpu", "worker_cpu", "master_cpu", "numa_node", "cpu_cluster"],
      "properties": {
        "local_port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "remote_port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "queue_id": {"type": "integer", "minimum": 0},
        "io_cpu": {"type": "integer", "minimum": 0},
        "worker_cpu": {"type": "integer", "minimum": 0},
        "master_cpu": {"type": "integer", "minimum": 0},
        "numa_node": {"type": "integer", "minimum": 0},
        "cpu_cluster": {"$ref": "#/$defs/id"}
      }
    },
    "cpus": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    }
  }
}
