{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nvidia.github.io/daqiri/schemas/daqiri-config-v1.schema.json",
  "title": "DAQIRI network configuration v1",
  "description": "The mapping stored under daqiri.cfg. Application-owned sibling mappings are outside this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "stream_type", "master_core", "memory_regions", "interfaces"],
  "properties": {
    "version": {"const": 1},
    "stream_type": {"enum": ["raw", "socket"]},
    "engine": {"enum": ["default", "dpdk", "socket", "ibverbs"]},
    "master_core": {"type": "integer", "minimum": -1, "maximum": 2147483647},
    "debug": {"type": "boolean"},
    "log_level": {"enum": ["trace", "debug", "info", "warn", "error", "critical", "off"]},
    "loopback": {"enum": ["", "sw", "hw"]},
    "tx_meta_buffers": {"$ref": "#/definitions/positiveUint32"},
    "rx_meta_buffers": {"$ref": "#/definitions/positiveUint32"},
    "memory_regions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/memoryRegion"}
    },
    "interfaces": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/interface"}
    }
  },
  "definitions": {
    "core": {
      "oneOf": [
        {"type": "integer", "minimum": -1, "maximum": 2147483647},
        {"type": "string", "pattern": "^-?[0-9]+$"}
      ]
    },
    "uint8": {"type": "integer", "minimum": 0, "maximum": 255},
    "uint16": {"type": "integer", "minimum": 0, "maximum": 65535},
    "uint32": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "uint64": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "positiveInt32": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "positiveUint32": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "positiveUint64": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
    "memoryRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "affinity", "num_bufs", "buf_size"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["huge", "device", "host_pinned", "host"]},
        "affinity": {"$ref": "#/definitions/uint16"},
        "access": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["local", "rdma_read", "rdma_write"]}
        },
        "num_bufs": {"$ref": "#/definitions/positiveUint64"},
        "buf_size": {"$ref": "#/definitions/positiveUint64"},
        "owned": {
          "type": "boolean",
          "description": "Deprecated compatibility field. Prefer runtime external-memory bindings."
        }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "address"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "address": {"type": "string", "minLength": 1},
        "socket_config": {"$ref": "#/definitions/socketConfig"},
        "roce_config": {"$ref": "#/definitions/roceConfig"},
        "rx": {"$ref": "#/definitions/rx"},
        "tx": {"$ref": "#/definitions/tx"}
      },
      "anyOf": [
        {"required": ["rx"]},
        {"required": ["tx"]}
      ]
    },
    "socketConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["client", "server"]},
        "local_addr": {"type": "string", "minLength": 1},
        "remote_addr": {"type": "string", "minLength": 1},
        "max_payload_size": {"type": "integer", "minimum": 1, "maximum": 65535},
        "max_burst_interval_ms": {"$ref": "#/definitions/uint64"},
        "min_ipg_ns": {"$ref": "#/definitions/uint32"},
        "retry_connect_s": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "local_ip": {"type": "string", "description": "Deprecated; use local_addr."},
        "local_port": {"$ref": "#/definitions/uint16"},
        "remote_ip": {"type": "string", "description": "Deprecated; use remote_addr."},
        "remote_port": {"$ref": "#/definitions/uint16"}
      }
    },
    "roceConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport_mode"],
      "properties": {
        "transport_mode": {"enum": ["RC", "UC", "UD"]}
      }
    },
    "rx": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queues"],
      "properties": {
        "flow_isolation": {"type": "boolean"},
        "dynamic_flow_capacity": {"$ref": "#/definitions/uint32"},
        "hardware_timestamps": {"type": "boolean"},
        "queues": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/rxQueue"}},
        "flows": {"type": "array", "items": {"$ref": "#/definitions/flow"}},
        "flex_items": {"type": "array", "items": {"$ref": "#/definitions/flexItem"}},
        "reorder_configs": {"type": "array", "items": {"$ref": "#/definitions/reorder"}}
      }
    },
    "tx": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queues"],
      "properties": {
        "accurate_send": {"type": "boolean"},
        "queues": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/txQueue"}},
        "flows": {"type": "array", "items": {"$ref": "#/definitions/flow"}}
      }
    },
    "rxQueue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "id"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "id": {"$ref": "#/definitions/uint16"},
        "poll_mode": {"enum": ["indirect", "direct"]},
        "cpu_core": {"$ref": "#/definitions/core"},
        "batch_size": {"$ref": "#/definitions/positiveInt32"},
        "memory_regions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "timeout_us": {"$ref": "#/definitions/uint64"}
      }
    },
    "txQueue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "id"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "id": {"$ref": "#/definitions/uint16"},
        "poll_mode": {"enum": ["indirect", "direct"]},
        "cpu_core": {"$ref": "#/definitions/core"},
        "batch_size": {"$ref": "#/definitions/positiveInt32"},
        "memory_regions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "offloads": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["tx_eth_src"]}
        },
        "pacing_mbps": {"$ref": "#/definitions/uint64"},
        "timeout_us": {
          "$ref": "#/definitions/uint64",
          "description": "Deprecated ignored field retained for checked-in config compatibility."
        }
      }
    },
    "flexItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "id", "udp_dst_port", "offset"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "id": {"$ref": "#/definitions/uint16"},
        "udp_dst_port": {"$ref": "#/definitions/uint16"},
        "offset": {"type": "integer", "minimum": 0, "maximum": 28, "multipleOf": 4}
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "id"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "id": {"$ref": "#/definitions/uint32"},
        "match": {"$ref": "#/definitions/flowMatch"},
        "action": {"$ref": "#/definitions/flowAction"},
        "actions": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/flowAction"}}
      },
      "oneOf": [
        {"required": ["action"], "not": {"required": ["actions"]}},
        {"required": ["actions"], "not": {"required": ["action"]}}
      ]
    },
    "flowMatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "udp_src": {"$ref": "#/definitions/uint16"},
        "udp_dst": {"$ref": "#/definitions/uint16"},
        "ipv4_len": {"$ref": "#/definitions/uint16"},
        "ipv4_src": {"type": "string"},
        "ipv4_dst": {"type": "string"},
        "flex_item_id": {"$ref": "#/definitions/uint16"},
        "val": {"$ref": "#/definitions/uint32"},
        "mask": {"$ref": "#/definitions/uint32"},
        "ethernet": {"$ref": "#/definitions/ethernetMatch"},
        "ecpri": {"$ref": "#/definitions/ecpriMatch"}
      }
    },
    "ethernetMatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "src": {"type": "string"},
        "dst": {"type": "string"}
      },
      "minProperties": 1
    },
    "ecpriMatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "msg_type": {"$ref": "#/definitions/uint8"},
        "pc_id": {"$ref": "#/definitions/uint16"},
        "rtc_id": {"$ref": "#/definitions/uint16"}
      }
    },
    "flowAction": {
      "oneOf": [
        {"$ref": "#/definitions/queueAction"},
        {"$ref": "#/definitions/vlanPushAction"},
        {"$ref": "#/definitions/vlanPopAction"},
        {"$ref": "#/definitions/tunnelAction"}
      ]
    },
    "queueAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"const": "queue"},
        "id": {"$ref": "#/definitions/uint16"},
        "ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/uint16"}}
      },
      "oneOf": [
        {"required": ["id"], "not": {"required": ["ids"]}},
        {"required": ["ids"], "not": {"required": ["id"]}}
      ]
    },
    "vlanPushAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "vlan_id"],
      "properties": {
        "type": {"const": "vlan_push"},
        "vlan_id": {"type": "integer", "minimum": 0, "maximum": 4095},
        "pcp": {"type": "integer", "minimum": 0, "maximum": 7},
        "dei": {"type": "integer", "minimum": 0, "maximum": 1},
        "ethertype": {"$ref": "#/definitions/uint16"}
      }
    },
    "vlanPopAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {"type": {"const": "vlan_pop"}}
    },
    "tunnelAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "tunnel"],
      "properties": {
        "type": {"enum": ["tunnel_encap", "tunnel_decap"]},
        "tunnel": {"$ref": "#/definitions/tunnel"}
      }
    },
    "tunnel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["vxlan", "gre", "nvgre"]},
        "outer_eth_src": {"type": "string"},
        "outer_eth_dst": {"type": "string"},
        "outer_ipv4_src": {"type": "string"},
        "outer_ipv4_dst": {"type": "string"},
        "outer_ipv4_ttl": {"$ref": "#/definitions/uint8"},
        "outer_ipv4_tos": {"$ref": "#/definitions/uint8"},
        "outer_udp_src": {"$ref": "#/definitions/uint16"},
        "outer_udp_dst": {"$ref": "#/definitions/uint16"},
        "vni": {"$ref": "#/definitions/uint32"},
        "gre_protocol": {"$ref": "#/definitions/uint16"},
        "tni": {"$ref": "#/definitions/uint32"},
        "flow_id": {"$ref": "#/definitions/uint8"}
      }
    },
    "reorder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "reorder_type", "memory_region", "payload_byte_offset", "flow_ids", "method"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "reorder_engine": {"enum": ["sw", "hw"]},
        "cyclic_sequence": {"type": "boolean"},
        "missing_action": {"enum": ["drop", "passthrough"]},
        "reorder_type": {"enum": ["cpu", "gpu"]},
        "memory_region": {"type": "string", "minLength": 1},
        "payload_byte_offset": {"$ref": "#/definitions/uint32"},
        "packet_size": {"$ref": "#/definitions/uint32"},
        "flow_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/uint32"}},
        "data_types": {"$ref": "#/definitions/dataTypes"},
        "method": {"$ref": "#/definitions/reorderMethod"}
      }
    },
    "dataTypes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_type": {"enum": ["int4", "int8", "int16", "int32"]},
        "output_type": {"enum": ["fp16", "bf16", "fp32", "fp64", "int32", "int8"]},
        "endianness": {"enum": ["host", "network"]},
        "input": {"enum": ["int4", "int8", "int16", "int32"], "description": "Deprecated alias for input_type."},
        "output": {"enum": ["fp16", "bf16", "fp32", "fp64", "int32", "int8"], "description": "Deprecated alias for output_type."},
        "input_endianness": {"enum": ["host", "network"], "description": "Deprecated alias for endianness."}
      },
      "allOf": [
        {"anyOf": [{"required": ["input_type"]}, {"required": ["input"]}]},
        {"anyOf": [{"required": ["output_type"]}, {"required": ["output"]}]}
      ]
    },
    "reorderMethod": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seq_batch_number": {"$ref": "#/definitions/seqBatchNumber"},
        "seq_packets_per_batch": {"$ref": "#/definitions/seqPacketsPerBatch"}
      },
      "oneOf": [
        {
          "required": ["seq_batch_number"],
          "not": {"required": ["seq_packets_per_batch"]}
        },
        {
          "required": ["seq_packets_per_batch"],
          "not": {"required": ["seq_batch_number"]}
        }
      ]
    },
    "bitField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bit_offset", "bit_width"],
      "properties": {
        "bit_offset": {"$ref": "#/definitions/uint16"},
        "bit_width": {"type": "integer", "minimum": 1, "maximum": 32}
      }
    },
    "seqBatchNumber": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence_number", "batch_number"],
      "properties": {
        "sequence_number": {"$ref": "#/definitions/bitField"},
        "batch_number": {"$ref": "#/definitions/bitField"}
      }
    },
    "seqPacketsPerBatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence_number", "packets_per_batch"],
      "properties": {
        "sequence_number": {"$ref": "#/definitions/bitField"},
        "packets_per_batch": {"$ref": "#/definitions/positiveUint32"}
      }
    }
  }
}
