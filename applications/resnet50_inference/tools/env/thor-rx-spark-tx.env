# Thor IGX (RX + inference, containerized) <- DGX Spark spark-f2d7 (TX, bare metal)
# Direct 200 GbE cable, no switch.
#
#   source with:  RX_ENV=applications/resnet50_inference/tools/env/thor-rx-spark-tx.env \
#                 ./applications/resnet50_inference/tools/run_resnet_xhost.sh --seconds 30
#
# Asymmetric pair: different repo paths, different configs, and both sides run
# in containers built for their own host.
#
# No sudo in either launcher: both accounts are in the `docker` group, so the
# daemon socket is reachable directly. That keeps the whole run non-interactive
# -- a `sudo` in the TX launcher would block on a password prompt over ssh that
# has no tty to display it, and the run would hang rather than fail.

# ---- hosts -------------------------------------------------------------------
TX_HOST="rgurunathan@10.221.0.17"     # spark-f2d7
RX_HOST="localhost"                    # the Thor itself
RX_IFACE="enP4p3s0f1np1"               # 0004:03:00.1, MAC ac:3a:e2:86:7a:0f

# ---- repo roots (they differ) ------------------------------------------------
TX_REPO="/home/rgurunathan/projects/daqiri"
RX_REPO="/home/rguru/projects/daqiri"

# ---- TX: containerized on the Spark ------------------------------------------
# The Spark binary links TensorRT, DPDK and daqiri's own shared objects, none of
# which exist on that host outside the image -- so TX runs in a container too.
# TX still touches CUDA (pcap_replayer memcpys into a host_pinned TX region), so
# the GPU must be visible, not just the TensorRT libs the linker wants.
#
# --gpus all is correct here, unlike on the Thor: the Spark's GB10 is the only
# GPU, so there is no iGPU/dGPU enumeration split to work around.
#
# -e ETH_DST_ADDR is load-bearing -- it is how the runner passes the RX MAC in.
TX_LAUNCHER="docker run --rm --network host \
  --gpus all \
  --device /dev/infiniband \
  --cap-add NET_RAW --cap-add NET_ADMIN --cap-add IPC_LOCK \
  --cap-add SYS_RESOURCE --cap-add SYS_RAWIO --cap-add SYS_NICE --ulimit memlock=-1 \
  -e HOME=/tmp -e ETH_DST_ADDR \
  -v /home/rgurunathan/projects/daqiri:/workspace/daqiri \
  -v /dev/hugepages:/dev/hugepages \
  -w /workspace/daqiri daqiri:torch-dpdk-spark"

# Container-side paths (what TX_LAUNCHER sees, not the host).
TX_BIN="/workspace/daqiri/build-app/applications/resnet50_inference/daqiri_resnet50_inference"
TX_CFG="/workspace/daqiri/applications/resnet50_inference/configs/resnet50_tx_spark_thor.yaml"

# ---- RX: containerized on the Thor -------------------------------------------
# CDI mode (--device nvidia.com/gpu=1) rather than --runtime=nvidia: the Tegra
# runtime auto-selects csv mode, which exposes only the iGPU, and the iGPU
# cannot export a dmabuf. Do NOT add --privileged -- it floods /dev with Tegra
# iGPU nodes and CUDA dies with NvRmMemInitNvmap. NIC access is granted with
# explicit caps instead.
RX_LAUNCHER="docker run --rm --network host \
  --device nvidia.com/gpu=1 \
  --device /dev/infiniband \
  --cap-add NET_RAW --cap-add NET_ADMIN --cap-add IPC_LOCK \
  --cap-add SYS_RESOURCE --cap-add SYS_RAWIO --cap-add SYS_NICE --ulimit memlock=-1 \
  -e HOME=/tmp \
  -v /home/rguru/projects/daqiri:/workspace/daqiri \
  -v /dev/hugepages:/dev/hugepages \
  -w /workspace/daqiri daqiri:torch"

# Container-side paths (what RX_LAUNCHER sees, not the host).
RX_BIN="/workspace/daqiri/build-resnet/applications/resnet50_inference/daqiri_resnet50_inference"
RX_CFG="/workspace/daqiri/applications/resnet50_inference/configs/resnet50_rx_thor_xhost.yaml"
