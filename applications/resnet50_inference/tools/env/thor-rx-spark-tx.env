# IGX Thor RX <- DGX Spark TX, direct 200 GbE cable.
TX_HOST="spark-bench"
RX_HOST="localhost"
RX_IFACE="enP4p3s0f1np1"

TX_REPO="/home/rgurunathan/projects/daqiri-issue73"
RX_REPO="/home/rguru/projects/daqiri"

TX_LAUNCHER="docker run --rm --network host \
  --gpus all --device /dev/infiniband \
  --cap-add NET_RAW --cap-add NET_ADMIN --cap-add IPC_LOCK \
  --cap-add SYS_RESOURCE --cap-add SYS_RAWIO --cap-add SYS_NICE --ulimit memlock=-1 \
  -e HOME=/tmp -e ETH_DST_ADDR \
  -v /home/rgurunathan/projects/daqiri-issue73:/workspace/daqiri \
  -v /tmp:/campaign \
  -v /dev/hugepages:/dev/hugepages \
  -w /workspace/daqiri daqiri:torch-dpdk-spark"
TX_BIN="/workspace/daqiri/build-app/applications/resnet50_inference/daqiri_resnet50_inference"
TX_CFG="/workspace/daqiri/applications/resnet50_inference/configs/resnet50_tx_spark_thor_hw.yaml"

# CDI UUID selection prevents the Tegra runtime from exposing the integrated
# Thor GPU in place of the discrete RTX PRO 6000.
RX_LAUNCHER="docker run --rm --network host \
  --device nvidia.com/gpu=GPU-5f077945-4eac-c3f4-7939-ec8d5457c4b8 \
  --device /dev/infiniband \
  --cap-add NET_RAW --cap-add NET_ADMIN --cap-add IPC_LOCK \
  --cap-add SYS_RESOURCE --cap-add SYS_RAWIO --cap-add SYS_NICE --ulimit memlock=-1 \
  -e HOME=/tmp \
  -v /home/rguru/projects/daqiri:/workspace/daqiri \
  -v /dev/hugepages:/dev/hugepages \
  -w /workspace/daqiri daqiri:torch"
RX_BIN="/workspace/daqiri/build-campaign-torch/applications/resnet50_inference/daqiri_resnet50_inference"
RX_CFG="/workspace/daqiri/applications/resnet50_inference/configs/resnet50_rx_thor_xhost_hw.yaml"
