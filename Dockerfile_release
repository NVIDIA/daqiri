# The published PyTorch application SDK includes compilers, Python bindings,
# benchmarks and tuning tools. Release dependencies and build settings live here.
# Review the base, package installs and CMake flags below for what is shipped.
# The source-collection helper only produces inventories, sources and notices.
# This manifest pins both linux/amd64 and linux/arm64. Update it deliberately.
FROM nvcr.io/nvidia/pytorch:26.10-py3@sha256:6d347d649d5dd108b4652f1b9cea6a3c859692ac408617a9108616da40e3da1f AS release-base
SHELL ["/bin/bash", "-eou", "pipefail", "-c"]
RUN mkdir -p /opt/daqiri-release \
    && printf '%s\n' "nvcr.io/nvidia/pytorch:26.10-py3@sha256:6d347d649d5dd108b4652f1b9cea6a3c859692ac408617a9108616da40e3da1f" > /opt/daqiri-release/base-image.txt \
    && dpkg-query -W -f='${binary:Package}\t${Version}\t${source:Package}\t${source:Version}\n' \
       > /opt/daqiri-release/base-packages.tsv \
    && python3 -c 'import importlib.metadata as m,json; print(json.dumps({d.metadata["Name"].lower().replace("_", "-"): d.version for d in m.distributions()}))' \
       > /opt/daqiri-release/base-python-packages.json

FROM release-base AS release-deps
ARG TARGETARCH
# Added/reinstalled binary packages and their matching source bundle.
# Ubuntu package versions resolve at build time and are recorded in packages.tsv.
ENV DEBIAN_FRONTEND=noninteractive \
    DOCA_VERSION=3.2.1 \
    RDMA_CORE_VERSION=2510.0.11-1 \
    MLNX_TOOLS_VERSION=2510.0.16-1 \
    OFED_KERNEL_UTILS_VERSION=25.10.OFED.25.10.1.7.1.1-1 \
    MFT_VERSION=4.34.1-10 \
    OFED_SOURCE_VERSION=25.10-1.7.1.0 \
    OFED_SOURCE_SHA256=56f173e1d538a23765d639dd382abc2f5caa0facaef2f30d4575fb2d375ae16a

# CVE-2026-109518: fixed in apt 2.8.4ubuntu0.1.
# Disabling retries blocks the exploit while installing the fixed APT packages.
RUN apt-get update -o Acquire::Retries=0 -o APT::Update::Error-Mode=any \
    && apt-get install -y --only-upgrade --no-install-recommends -o Acquire::Retries=0 \
         apt=2.8.4* \
         apt-utils=2.8.4* \
         libapt-pkg6.0t64=2.8.4* \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
    && case "${TARGETARCH}" in \
         amd64) doca_arch=x86_64 ;; \
         arm64) doca_arch=arm64-sbsa ;; \
         *) echo "Unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
       esac \
    && repo="https://linux.mellanox.com/public/repo/doca/${DOCA_VERSION}/ubuntu24.04/${doca_arch}" \
    && curl -fsSL "${repo}/GPG-KEY-Mellanox.pub" \
       | gpg --dearmor -o /usr/share/keyrings/daqiri-mellanox.gpg \
    && printf 'deb [signed-by=/usr/share/keyrings/daqiri-mellanox.gpg] %s ./\n' "${repo}" \
       > /etc/apt/sources.list.d/daqiri-mellanox.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends --reinstall \
         "libibverbs-dev=${RDMA_CORE_VERSION}" "libibverbs1=${RDMA_CORE_VERSION}" \
         "ibverbs-providers=${RDMA_CORE_VERSION}" "ibverbs-utils=${RDMA_CORE_VERSION}" \
         "librdmacm-dev=${RDMA_CORE_VERSION}" "librdmacm1=${RDMA_CORE_VERSION}" \
         "infiniband-diags=${RDMA_CORE_VERSION}" \
         "mlnx-tools=${MLNX_TOOLS_VERSION}" \
         "mlnx-ofed-kernel-utils=${OFED_KERNEL_UTILS_VERSION}" "mft=${MFT_VERSION}" \
    && apt-get install -y --no-install-recommends \
         build-essential cmake pkg-config libnuma-dev \
         python3-dev python3-pip python3-yaml pybind11-dev \
         pciutils ethtool iproute2 iputils-ping procps kmod \
    && rm -rf /var/lib/apt/lists/*

# Upgrade Nsight Systems CLI to remediate embedded Go CVEs.
ENV NSIGHT_SYSTEMS_VERSION=2026.6.1.218
RUN case "${TARGETARCH}" in \
      arm64) package=nsight-systems-cli-2026.6.1_2026.6.1.218-1_arm64.deb; \
        checksum=717815ac50b957b56fed9f4d78781cc5bb420b94fdf315ef82a82b3c6e8899e0 ;; \
      amd64) package=nsightsystems-linux-cli-public-2026.6.1.218-39266636.deb; \
        checksum=e71440978244e3883fc769da91a44a03451129ce21988d0db656a6bf7c1cb56b ;; \
      *) exit 1 ;; \
    esac \
    && curl -fsSL "https://developer.nvidia.com/downloads/assets/tools/secure/nsight-systems/2026_6/${package}" -o /tmp/nsight.deb \
    && printf '%s  /tmp/nsight.deb\n' "$checksum" | sha256sum -c - \
    && apt-get update \
    && apt-get remove -y nsight-systems-cli-2026.5.1 \
    && rm -rf /usr/local/cuda-13.4/NsightSystems-cli-2026.5.1 \
    && apt-get install -y --no-install-recommends /tmp/nsight.deb \
    && ln -sf /usr/local/bin/nsys /usr/local/cuda/bin/nsys \
    && /usr/local/bin/nsys --version \
    && test ! -e /usr/local/cuda-13.4/NsightSystems-cli-2026.5.1 \
    && rm -f /tmp/nsight.deb \
    && rm -rf /var/lib/apt/lists/*

# PyTorch 26.10 already carries newer versions of the previously upgraded
# notebook, networking, and packaging dependencies. Preserve its pinned stack.
# GHSA-27vj-qcqg-25rc: fixed in fsspec 2026.6.0.
# ONNX 1.23.2 retains the earlier ONNX security updates.
# Remove unused training tools: datasets caps fsspec; torchtitan needs datasets.
# W&B is unused by DAQIRI and bundles the vulnerable Go wandb-core executable.
# The base image's constraints pin older versions, so override them only here.
# Repair inherited 26.10 dependency inconsistencies: triton-kernels needs pytest,
# cupti-python needs the matching CUPTI wheel, and the bundled FlashAttention 4
# and QuACK releases pin mutually incompatible older CUTLASS DSL versions.
RUN python3 -m pip uninstall -y \
      datasets \
      torchtitan \
      wandb \
    && PIP_CONSTRAINT=/dev/null python3 -m pip install --no-cache-dir --no-deps \
      'fsspec==2026.6.0' \
      'onnx==1.23.2' \
      'pytest==8.4.2' \
      'iniconfig==2.1.0' \
      'pluggy==1.6.0' \
      'nvidia-cuda-cupti==13.4.92' \
      'quack-kernels==0.6.5' \
      'flash-attn-4==4.0.0b39' \
    && python3 -m pip check

# Prefer Ubuntu CMake 3.x over a pip CMake inherited from PyTorch.
ENV PATH=/opt/daqiri/bin:/usr/local/cuda/bin:/usr/bin:/usr/sbin:/bin:/sbin:/usr/local/bin:/usr/local/sbin

FROM release-deps AS release-build
WORKDIR /workspace/daqiri
COPY . .
RUN cmake -S . -B /tmp/daqiri-build \
      -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/daqiri \
      -DCMAKE_INSTALL_LIBDIR=lib \
      '-DCMAKE_CUDA_ARCHITECTURES=80;90;121' \
      -DBUILD_SHARED_LIBS=ON -DBUILD_TESTING=OFF \
      -DDAQIRI_ABI_VERSION=2 -DDAQIRI_IBVERBS_DLOPEN=OFF \
      -DDAQIRI_PREFER_SYSTEM_YAML_CPP=OFF -DDAQIRI_REORDER_GPU_PROFILE=OFF \
      -DYAML_CPP_BUILD_TOOLS=OFF -DYAML_CPP_BUILD_TESTS=OFF \
      -DDAQIRI_ENGINE=ibverbs -DDAQIRI_BUILD_PYTHON=ON \
      -DDAQIRI_BUILD_EXAMPLES=ON -DDAQIRI_BUILD_APPLICATIONS=OFF \
      -DDAQIRI_ENABLE_GDS=OFF -DDAQIRI_ENABLE_S3=OFF \
      -DDAQIRI_ENABLE_OTEL_METRICS=OFF \
    && cmake --build /tmp/daqiri-build -j 8 \
    && cmake --install /tmp/daqiri-build \
    && tar --exclude='*/.git' --exclude='*/__pycache__' -czf \
       /opt/daqiri-release/daqiri-source.tar.gz -C /workspace daqiri

# Source retrieval happens separately so it cannot change the final package set.
FROM release-deps AS release-sources
COPY VERSION /tmp/daqiri-components/VERSION
COPY THIRD-PARTY-NOTICES /tmp/daqiri-components/THIRD-PARTY-NOTICES
COPY third_party/yaml-cpp/CMakeLists.txt /tmp/daqiri-components/third_party/yaml-cpp/CMakeLists.txt
COPY third_party/spdlog/include/spdlog/version.h /tmp/daqiri-components/third_party/spdlog/include/spdlog/version.h
# Artifact bookkeeping only: the helper does not install binary packages or
# choose build settings. All its source inputs are explicit here.
COPY scripts/release/collect_sources.py /tmp/collect_sources.py
RUN python3 /tmp/collect_sources.py \
      --output /opt/daqiri-release \
      --component-root /tmp/daqiri-components \
      --project-notices /tmp/daqiri-components/THIRD-PARTY-NOTICES \
      --vendor-url "https://linux.mellanox.com/public/repo/doca/${DOCA_VERSION}/SOURCES/mlnx_ofed/MLNX_OFED_SRC-debian-${OFED_SOURCE_VERSION}.tgz" \
      --vendor-sha256 "${OFED_SOURCE_SHA256}"


FROM release-deps AS release
# Identification metadata only; these arguments do not select build settings.
ARG DAQIRI_REVISION=unknown
ARG DAQIRI_VERSION=unknown
LABEL org.opencontainers.image.title="DAQIRI application development SDK" \
      org.opencontainers.image.source="https://github.com/NVIDIA/daqiri" \
      org.opencontainers.image.revision="${DAQIRI_REVISION}" \
      org.opencontainers.image.version="${DAQIRI_VERSION}"
COPY --from=release-build /opt/daqiri /opt/daqiri
COPY --from=release-build /opt/daqiri-release/daqiri-source.tar.gz /opt/daqiri-release/
COPY --from=release-sources /opt/daqiri-release /opt/daqiri-release
COPY --from=release-sources /opt/daqiri-release/THIRD-PARTY-NOTICES /opt/daqiri/THIRD-PARTY-NOTICES
RUN printf '/opt/daqiri/lib\n' > /etc/ld.so.conf.d/daqiri.conf && ldconfig \
    && cd /opt/daqiri-release && sha256sum daqiri-source.tar.gz >> SHA256SUMS
ENV CMAKE_PREFIX_PATH=/opt/daqiri \
    PKG_CONFIG_PATH=/opt/daqiri/lib/pkgconfig \
    PYTHONPATH=/opt/daqiri/lib/python
WORKDIR /opt/daqiri
CMD ["/bin/bash"]
