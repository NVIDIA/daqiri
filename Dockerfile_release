# The published PyTorch application SDK includes compilers, Python bindings,
# benchmarks and tuning tools. All release dependencies and settings live here.
# This manifest pins both linux/amd64 and linux/arm64. Update it deliberately.
FROM nvcr.io/nvidia/pytorch:26.01-py3@sha256:38ed2ecb2c16d10677006d73fb0a150855d6ec81db8fc66e800b5ae92741007e AS release-base
SHELL ["/bin/bash", "-eou", "pipefail", "-c"]
RUN mkdir -p /opt/daqiri-release \
    && printf '%s\n' "nvcr.io/nvidia/pytorch:26.01-py3@sha256:38ed2ecb2c16d10677006d73fb0a150855d6ec81db8fc66e800b5ae92741007e" > /opt/daqiri-release/base-image.txt \
    && dpkg-query -W -f='${binary:Package}\t${Version}\t${source:Package}\t${source:Version}\n' \
       > /opt/daqiri-release/base-packages.tsv

FROM release-base AS release-deps
ARG TARGETARCH
# Binary packages and matching source bundle are reviewed together.
ENV DEBIAN_FRONTEND=noninteractive \
    DOCA_VERSION=3.2.1 \
    RDMA_CORE_VERSION=2510.0.11-1 \
    MLNX_TOOLS_VERSION=2510.0.16-1 \
    OFED_KERNEL_UTILS_VERSION=25.10.OFED.25.10.1.7.1.1-1 \
    MFT_VERSION=4.34.1-10 \
    OFED_SOURCE_VERSION=25.10-1.7.1.0 \
    OFED_SOURCE_SHA256=56f173e1d538a23765d639dd382abc2f5caa0facaef2f30d4575fb2d375ae16a

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
    && case "${TARGETARCH}" in \
         amd64) doca_arch=x86_64 ;; \
         arm64) doca_arch=arm64-sbsa ;; \
         *) echo "Unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
       esac \
    && repo="https://linux.mellanox.com/public/repo/doca/${DOCA_VERSION}/ubuntu24.04/${doca_arch}" \
    && curl -fsSL "${repo}/GPG-KEY-Mellanox.pub" \
       | gpg --dearmor -o /usr/share/keyrings/daqiri-mellanox.gpg \
    && printf 'deb [signed-by=/usr/share/keyrings/daqiri-mellanox.gpg] %s ./\n' "${repo}" \
       > /etc/apt/sources.list.d/daqiri-mellanox.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends --reinstall \
         "libibverbs-dev=${RDMA_CORE_VERSION}" "libibverbs1=${RDMA_CORE_VERSION}" \
         "ibverbs-providers=${RDMA_CORE_VERSION}" "ibverbs-utils=${RDMA_CORE_VERSION}" \
         "librdmacm-dev=${RDMA_CORE_VERSION}" "librdmacm1=${RDMA_CORE_VERSION}" \
         "infiniband-diags=${RDMA_CORE_VERSION}" \
         "mlnx-tools=${MLNX_TOOLS_VERSION}" \
         "mlnx-ofed-kernel-utils=${OFED_KERNEL_UTILS_VERSION}" "mft=${MFT_VERSION}" \
    && apt-get install -y --no-install-recommends \
         build-essential cmake pkg-config libnuma-dev \
         python3-dev python3-pip python3-yaml pybind11-dev \
         pciutils ethtool iproute2 iputils-ping procps kmod \
    && rm -rf /var/lib/apt/lists/*

# Prefer Ubuntu CMake 3.x over a pip CMake inherited from PyTorch.
ENV PATH=/opt/daqiri/bin:/usr/local/cuda/bin:/usr/bin:/usr/sbin:/bin:/sbin:/usr/local/bin:/usr/local/sbin

FROM release-deps AS release-build
WORKDIR /workspace/daqiri
COPY . .
RUN cmake -S . -B /tmp/daqiri-build \
      -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/daqiri \
      -DCMAKE_INSTALL_LIBDIR=lib \
      '-DCMAKE_CUDA_ARCHITECTURES=80;90;121' \
      -DBUILD_SHARED_LIBS=ON -DBUILD_TESTING=OFF \
      -DDAQIRI_ABI_VERSION=2 -DDAQIRI_IBVERBS_DLOPEN=OFF \
      -DDAQIRI_PREFER_SYSTEM_YAML_CPP=OFF -DDAQIRI_REORDER_GPU_PROFILE=OFF \
      -DYAML_CPP_BUILD_TOOLS=OFF -DYAML_CPP_BUILD_TESTS=OFF \
      -DDAQIRI_ENGINE=ibverbs -DDAQIRI_BUILD_PYTHON=ON \
      -DDAQIRI_BUILD_EXAMPLES=ON -DDAQIRI_BUILD_APPLICATIONS=OFF \
      -DDAQIRI_ENABLE_GDS=OFF -DDAQIRI_ENABLE_S3=OFF \
      -DDAQIRI_ENABLE_OTEL_METRICS=OFF \
    && cmake --build /tmp/daqiri-build -j 8 \
    && cmake --install /tmp/daqiri-build \
    && tar --exclude='*/.git' --exclude='*/__pycache__' -czf \
       /opt/daqiri-release/daqiri-source.tar.gz -C /workspace daqiri

# Source retrieval happens separately so it cannot change the final package set.
FROM release-deps AS release-sources
COPY VERSION /tmp/daqiri-components/VERSION
COPY third_party/yaml-cpp/CMakeLists.txt /tmp/daqiri-components/third_party/yaml-cpp/CMakeLists.txt
COPY third_party/spdlog/include/spdlog/version.h /tmp/daqiri-components/third_party/spdlog/include/spdlog/version.h
# Run with a quoted heredoc: dpkg-query's ${...} fields are Python literals.
# Missing exact sources fail the build; MFT's bundled OSS review remains explicit.
RUN python3 - <<'PY_SOURCES'
import os
import csv
import ctypes
import hashlib
import importlib.metadata
import json
from pathlib import Path
import re
import shutil
import subprocess
import tarfile


QUERY = "${binary:Package}\t${Version}\t${source:Package}\t${source:Version}\n"


def run(*args, **kwargs):
    return subprocess.run(args, check=True, text=True, **kwargs)


def packages(text):
    return {row[0]: row for row in csv.reader(text.splitlines(), delimiter="\t")}


def enable_ubuntu_sources():
    """Mirror Ubuntu binary repositories, including security and updates."""
    entries = []
    for path in Path("/etc/apt/sources.list.d").glob("*.sources"):
        for block in path.read_text().split("\n\n"):
            if "ubuntu.com" in block and re.search(r"^Types:.*\bdeb\b", block, re.M):
                entries.append(re.sub(r"^Types:.*$", "Types: deb-src", block, flags=re.M))
    if entries:
        Path("/etc/apt/sources.list.d/daqiri-source.sources").write_text(
            "\n\n".join(entries) + "\n"
        )
    lines = []
    for path in [Path("/etc/apt/sources.list"), *Path("/etc/apt/sources.list.d").glob("*.list")]:
        if path.exists():
            lines.extend(
                line.replace("deb ", "deb-src ", 1)
                for line in path.read_text().splitlines()
                if line.startswith("deb ") and "ubuntu.com" in line
            )
    if lines:
        Path("/etc/apt/sources.list.d/daqiri-source.list").write_text("\n".join(lines) + "\n")
    if not entries and not lines:
        raise RuntimeError("No Ubuntu repositories found for matching source retrieval")
    run("apt-get", "update")


def main():
    output = Path('/opt/daqiri-release')
    component_root = Path('/tmp/daqiri-components')
    doca_version = os.environ['DOCA_VERSION']
    source_version = os.environ['OFED_SOURCE_VERSION']
    vendor_url = (f'https://linux.mellanox.com/public/repo/doca/{doca_version}/'
                  f'SOURCES/mlnx_ofed/MLNX_OFED_SRC-debian-{source_version}.tgz')
    vendor_sha256 = os.environ['OFED_SOURCE_SHA256']
    yaml_cmake = (component_root / "third_party/yaml-cpp/CMakeLists.txt").read_text()
    spdlog_header = (component_root / "third_party/spdlog/include/spdlog/version.h").read_text()
    yaml_version = re.search(r"project\(YAML_CPP VERSION ([0-9.]+)", yaml_cmake)[1]
    spdlog_version = ".".join(
        re.search(rf"#define SPDLOG_VER_{part}\s+(\d+)", spdlog_header)[1]
        for part in ("MAJOR", "MINOR", "PATCH")
    )
    with (output / "components.tsv").open("w") as stream:
        writer = csv.writer(stream, delimiter="\t")
        writer.writerow(["component", "version", "source_artifact", "license_notice"])
        for name, version, notice in (
            ("daqiri", (component_root / "VERSION").read_text().strip(), "daqiri/LICENSE"),
            ("yaml-cpp", yaml_version, "daqiri/third_party/yaml-cpp/LICENSE"),
            ("spdlog", spdlog_version, "daqiri/third_party/spdlog/LICENSE"),
        ):
            writer.writerow([name, version, "daqiri-source.tar.gz", notice])
    current_text = run("dpkg-query", "-W", f"-f={QUERY}", capture_output=True).stdout
    (output / "packages.tsv").write_text(current_text)
    baseline = packages((output / "base-packages.tsv").read_text())
    current = packages(current_text)
    added = {name: row for name, row in current.items() if baseline.get(name) != row}
    # Reinstalled provider packages can have the same version as the base but
    # repair stripped NGC headers/symlinks. Include their sources regardless.
    for name, row in current.items():
        if row[2] in {"rdma-core", "mlnx-tools", "mlnx-ofed-kernel", "mft"}:
            added[name] = row
    source_dir = output / "sources"
    source_dir.mkdir()
    notices = output / "notices"
    notices.mkdir()
    sources = sorted({(row[2], row[3]) for row in added.values()})
    enable_ubuntu_sources()

    # The vendor does not publish a deb-src index. Its matching source bundle
    # contains the original source archives, including their packaging files.
    bundle = Path("/tmp/daqiri-ofed-source.tgz")
    run("curl", "-fsSL", vendor_url, "-o", str(bundle))
    digest = hashlib.sha256(bundle.read_bytes()).hexdigest()
    if digest != vendor_sha256:
        raise RuntimeError(f"Vendor source checksum mismatch: {digest}")
    provenance = []
    with tarfile.open(bundle) as archive:
        for source, version in sources:
            if source == "mft":
                # A proprietary Debian package can still bundle OSS outside
                # dpkg's dependency graph. Do not claim complete source coverage.
                library = Path("/usr/lib64/mft/ext_libs/libcrypto.so.3")
                crypto = ctypes.CDLL(str(library))
                crypto.OpenSSL_version.restype = ctypes.c_char_p
                review = {
                    "source": source, "version": version,
                    "kind": "proprietary package with bundled OSS",
                    "review_required": True,
                    "bundled_library": str(library),
                    "bundled_version": crypto.OpenSSL_version(0).decode(),
                    "reason": "Matching vendor sources and notices for bundled OSS are not supplied by the Debian package.",
                }
                provenance.append(review)
                (output / "source-review.json").write_text(json.dumps(review, indent=2) + "\n")
                continue
            destination = source_dir / source
            destination.mkdir()
            if source in {"rdma-core", "mlnx-tools", "mlnx-ofed-kernel"}:
                upstream = version.rsplit("-", 1)[0]
                filename = f"{source}_{upstream}.orig.tar.gz"
                members = [m for m in archive.getmembers() if m.name.endswith("/" + filename)]
                if len(members) != 1 or not members[0].isfile():
                    raise RuntimeError(f"Missing exact vendor source: {source}={version}")
                with archive.extractfile(members[0]) as src, (destination / filename).open("wb") as dst:
                    shutil.copyfileobj(src, dst)
                provenance.append({"source": source, "version": version, "url": vendor_url,
                                   "bundle_sha256": digest, "member": members[0].name})
            else:
                run("apt-get", "source", "--download-only", f"{source}={version}", cwd=destination)
                provenance.append({"source": source, "version": version, "kind": "Ubuntu source package"})

    rows = []
    for name, row in sorted(added.items()):
        package = name.split(":", 1)[0]
        doc = Path("/usr/share/doc") / package
        notice = doc / "copyright"
        license_names = []
        if notice.exists():
            target = notices / f"{package}.copyright"
            shutil.copyfile(notice, target)
            license_names = sorted(set(re.findall(r"^License:\s*(.+)$", notice.read_text(errors="replace"), re.M)))
        # Retain all small package terms, including MFT's proprietary license.
        if doc.exists():
            for path in doc.rglob("*"):
                if path.is_file() and any(word in path.name.lower() for word in ("license", "copying", "eula", "notice")):
                    target = notices / package / path.relative_to(doc)
                    target.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copyfile(path, target)
        rows.append([*row, "; ".join(license_names) or "See package notices and source archive"])
    with (output / "added-packages.tsv").open("w") as stream:
        writer = csv.writer(stream, delimiter="\t")
        writer.writerow(["package", "version", "source", "source_version", "license_notice"])
        writer.writerows(rows)
    shutil.copytree("/usr/share/common-licenses", notices / "common-licenses")
    (output / "source-provenance.json").write_text(json.dumps(provenance, indent=2) + "\n")
    python_packages = sorted(
        ({"name": dist.metadata["Name"], "version": dist.version} for dist in importlib.metadata.distributions()),
        key=lambda row: (row["name"] or "").lower(),
    )
    (output / "python-packages.json").write_text(json.dumps(python_packages, indent=2) + "\n")
    checksums = []
    for path in sorted(output.rglob("*")):
        if path.is_file():
            checksums.append(f"{hashlib.sha256(path.read_bytes()).hexdigest()}  {path.relative_to(output)}")
    (output / "SHA256SUMS").write_text("\n".join(checksums) + "\n")


if __name__ == "__main__":
    main()
PY_SOURCES

FROM release-deps AS release
LABEL org.opencontainers.image.title="DAQIRI application development SDK" \
      org.opencontainers.image.source="https://github.com/NVIDIA/daqiri"
COPY --from=release-build /opt/daqiri /opt/daqiri
COPY --from=release-build /opt/daqiri-release/daqiri-source.tar.gz /opt/daqiri-release/
COPY --from=release-sources /opt/daqiri-release /opt/daqiri-release
RUN printf '/opt/daqiri/lib\n' > /etc/ld.so.conf.d/daqiri.conf && ldconfig \
    && cd /opt/daqiri-release && sha256sum daqiri-source.tar.gz >> SHA256SUMS
ENV CMAKE_PREFIX_PATH=/opt/daqiri \
    PKG_CONFIG_PATH=/opt/daqiri/lib/pkgconfig \
    PYTHONPATH=/opt/daqiri/lib/python
WORKDIR /opt/daqiri
CMD ["/bin/bash"]
